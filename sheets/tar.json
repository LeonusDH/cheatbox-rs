  "Which one?": [
    {
      "command": "zstd",
      "description": "Fast and strong: the best default"
    },
    {
      "command": "xz",
      "description": "Smallest files, slow to compress"
    },
    {
      "command": "gzip",
      "description": "Works everywhere, fast, larger files"
    },
    {
      "command": "zip",
      "description": "Best for sharing with Windows users"
    },
    {
      "command": "7z",
      "description": "Strong ratio and real AES encryption"
    }
  ]

  "Basics": [
    {
      "command": "nft list ruleset",
      "description": "Show everything"
    },
    {
      "command": "nft -a list ruleset",
      "description": "Show with rule handles"
    },
    {
      "command": "nft -c -f /etc/nftables.conf",
      "description": "Check a file without applying"
    },
    {
      "command": "nft -f /etc/nftables.conf",
      "description": "Apply a ruleset file atomically"
    },
    {
      "command": "nft flush ruleset",
      "description": "Remove all tables and rules"
    },
    {
      "command": "systemctl enable --now nftables",
      "description": "Load the config on boot"
    }
  ],
  "Tables & Chains": [
    {
      "command": "nft add table inet filter",
      "description": "Table for IPv4 + IPv6"
    },
    {
      "command": "nft add chain inet filter input '{ type filter hook input priority 0; policy drop; }'",
      "description": "Base chain on the input hook"
    },
    {
      "command": "nft add chain inet filter mychain",
      "description": "Regular chain (for jump/goto)"
    },
    {
      "command": "nft list table inet filter",
      "description": "Show one table"
    },
    {
      "command": "nft list chains",
      "description": "All chains"
    },
    {
      "command": "nft delete table inet filter",
      "description": "Remove a table"
    }
  ],
  "Rules (nft add rule inet filter input …)": [
    {
      "command": "ct state established,related accept",
      "description": "Allow replies"
    },
    {
      "command": "ct state invalid drop",
      "description": "Drop broken packets"
    },
    {
      "command": "iifname \"lo\" accept",
      "description": "Allow loopback"
    },
    {
      "command": "tcp dport 22 accept",
      "description": "Allow a port"
    },
    {
      "command": "tcp dport { 80, 443 } accept",
      "description": "Several ports at once"
    },
    {
      "command": "ip saddr 10.0.0.0/8 tcp dport 22 accept",
      "description": "Port only from a subnet"
    },
    {
      "command": "meta l4proto icmp accept",
      "description": "Allow ping (IPv6: meta l4proto ipv6-icmp)"
    }
  ],
  "Editing Rules": [
    {
      "command": "nft -a list chain inet filter input",
      "description": "Find a rule's handle"
    },
    {
      "command": "nft delete rule inet filter input handle <h>",
      "description": "Delete by handle"
    },
    {
      "command": "nft insert rule inet filter input <rule>",
      "description": "Add at the top"
    },
    {
      "command": "nft add rule … position <h> <rule>",
      "description": "Add after handle <h>"
    },
    {
      "command": "nft replace rule … handle <h> <rule>",
      "description": "Replace in place"
    },
    {
      "command": "nft flush chain inet filter input",
      "description": "Empty a chain"
    }
  ],
  "Sets": [
    {
      "command": "nft add set inet filter bl '{ type ipv4_addr; flags interval; }'",
      "description": "Set of IPs/subnets"
    },
    {
      "command": "nft add element inet filter bl '{ 203.0.113.0/24 }'",
      "description": "Add to a set"
    },
    {
      "command": "nft delete element inet filter bl '{ <ip> }'",
      "description": "Remove from a set"
    },
    {
      "command": "ip saddr @bl drop",
      "description": "Rule that uses the set"
    },
    {
      "command": "'{ type ipv4_addr; flags timeout; timeout 1h; }'",
      "description": "Elements expire automatically"
    },
    {
      "command": "nft list set inet filter bl",
      "description": "Show set contents"
    }
  ],
  "NAT, Logging & Debug": [
    {
      "command": "nft add table ip nat",
      "description": "Table for NAT"
    },
    {
      "command": "oifname \"eth0\" masquerade",
      "description": "Source NAT (postrouting chain)"
    },
    {
      "command": "tcp dport 8080 dnat to 10.0.0.2:80",
      "description": "Port forward (prerouting chain)"
    },
    {
      "command": "log prefix \"nft-drop: \" drop",
      "description": "Log then drop (see dmesg/journal)"
    },
    {
      "command": "limit rate 10/second accept",
      "description": "Rate limit"
    },
    {
      "command": "counter",
      "description": "Add to a rule to count packets"
    },
    {
      "command": "nft monitor trace",
      "description": "Trace packets marked: meta nftrace set 1"
    },
    {
      "command": "iptables-translate -A INPUT -p tcp --dport 22 -j ACCEPT",
      "description": "Convert iptables syntax"
    }
  ]

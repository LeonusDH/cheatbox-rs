        "[red3]   '----.-----'[/]",
        "[red3]        |[/]",
        "[red3]        v[/]   [dim]/usr[/]"
      ]
    }
  ],
  "TITLE": [
    {
      "ascii": [
        "               __ ",
        "  ____ _____  / /_",
        " / __ `/ __ \\/ __/",
        "/ /_/ / /_/ / /_  ",

      "ascii": [
        "",
        "[deep_sky_blue2]   .--->---.[/]",
        "[deep_sky_blue2]   |[/] [white]-Syu[/]  [deep_sky_blue2]|[/]   [dim]sync, refresh,[/]",
        "[deep_sky_blue2]   '---<---'[/]   [dim]upgrade[/]",
        ""
      ]
    }
  ],
  "TITLE": [
    {
      "ascii": [
        "                                          ",
        "    ____  ____ __________ ___  ____ _____ ",
        "   / __ \\/ __ `/ ___/ __ `__ \\/ __ `/ __ \\",
        "  / /_/ / /_/ / /__/ / / / / / /_/ / / / /",
        " / .___/\\__,_/\\___/_/ /_/ /_/\\__,_/_/ /_/ ",
        "/_/                                       "
      ]
    }
  ],
  "STYLE": {
    "command_width": 34,
    "outer_width": 150,
    "primary_color": "deep_sky_blue2"
  },
  "Install & Remove": [
    {
      "command": "pacman -Syu",
      "description": "Full system upgrade (never just -Sy)"
    },
    {
      "command": "pacman -S <pkg>",
      "description": "Install (do -Syu first)"
    },
    {
      "command": "pacman -S --needed <pkg>",
      "description": "Skip if already up to date"
    },
    {
      "command": "pacman -U file.pkg.tar.zst",
      "description": "Install a local package"
    },
    {
      "command": "pacman -R <pkg>",
      "description": "Remove a package"
    },
    {
      "command": "pacman -Rns <pkg>",
      "description": "Remove with unneeded deps and configs"
    }
  ],
  "Query Installed (-Q)": [
    {
      "command": "pacman -Qe",
      "description": "Explicitly installed packages"
    },
    {
      "command": "pacman -Qi <pkg>",
      "description": "Info about an installed package"
    },
    {
      "command": "pacman -Ql <pkg>",
      "description": "Files of a package"
    },
    {
      "command": "pacman -Qo /path/to/file",
      "description": "Which package owns a file"
    },
    {
      "command": "pacman -Qdt",
      "description": "Orphans (deps nobody needs)"
    },
    {
      "command": "pacman -Qm",
      "description": "Foreign packages (AUR, manual)"
    }
  ],
  "Search Repos (-S, -F)": [
    {
      "command": "pacman -Ss <term>",
      "description": "Search the repos"
    },
    {
      "command": "pacman -Si <pkg>",
      "description": "Info from the repos"
    },
    {
      "command": "pacman -Fy",
      "description": "Refresh the file database"
    },
    {
      "command": "pacman -F <file>",
      "description": "Which package ships a file"
    },
    {
      "command": "pacman -Sw <pkg>",
      "description": "Download only"
    },
    {
      "command": "pacman -Syy",
      "description": "Force refresh of all databases"
    }
  ],
  "Maintenance": [
    {
      "command": "pacman -Qdtq | pacman -Rns -",
      "description": "Remove all orphans"
    },
    {
      "command": "paccache -r",
      "description": "Keep last 3 versions in cache (pacman-contrib)"
    },
    {
      "command": "pacman -Sc",
      "description": "Clean cache of uninstalled packages"
    },
    {
      "command": "checkupdates",
      "description": "Pending updates, safely (pacman-contrib)"
    },
    {
      "command": "pacdiff",
      "description": "Merge .pacnew config files (pacman-contrib)"
    },
    {
      "command": "pacman -Qkk <pkg>",
      "description": "Verify installed files"
    }
  ],
  "AUR (yay / paru)": [
    {
      "command": "yay",
      "description": "Upgrade repo + AUR packages"
    },
    {
      "command": "yay -S <pkg>",
      "description": "Install from repos or AUR"
    },
    {
      "command": "yay -Yc",
      "description": "Remove unneeded dependencies"
    },
    {
      "command": "paru -Sua",
      "description": "Upgrade AUR packages only"
    },
    {
      "command": "git clone https://aur.archlinux.org/<pkg>.git",
      "description": "Manual AUR: fetch the PKGBUILD"
    },
    {
      "command": "makepkg -si",
      "description": "Build and install it (read PKGBUILD!)"
    }
  ],
  "Config & Troubleshooting": [
    {
      "command": "/etc/pacman.conf",
      "description": "Color, ParallelDownloads, IgnorePkg"
    },
    {
      "command": "reflector --latest 20 --sort rate --save /etc/pacman.d/mirrorlist",
      "description": "Pick fast mirrors"
    },
    {
      "command": "pacman -Sy archlinux-keyring && pacman -Su",
      "description": "Fix 'invalid signature' errors"
    },
    {
      "command": "pacman-key --init && pacman-key --populate",
      "description": "Rebuild the keyring"
    },
    {
      "command": "rm /var/lib/pacman/db.lck",
      "description": "Stale lock — only if no pacman runs"
    }
  ]
}
